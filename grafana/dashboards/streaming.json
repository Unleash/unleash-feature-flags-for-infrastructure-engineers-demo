{
  "uid": "streaming-demo",
  "title": "Schedule Calculation - Streaming vs Polling",
  "schemaVersion": 39,
  "refresh": "1s",
  "graphTooltip": 1,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "/schedule-calculation RPS: calculated vs cached",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "calculated"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cached"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFFFFF"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (served) (rate(demo_schedule_calculation_responses_total[$__rate_interval]))) or label_replace(vector(0), \"served\", \"calculated\", \"\", \"\") or label_replace(vector(0), \"served\", \"cached\", \"\", \"\")",
          "legendFormat": "{{served}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "/schedule-calculation latency (p99 / p99.9 / max)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99.9"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max (bucketed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/schedule-calculation\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "((histogram_quantile(0.999, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/schedule-calculation\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99.9"
        },
        {
          "refId": "C",
          "expr": "((histogram_quantile(1, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/schedule-calculation\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "max (bucketed)"
        }
      ]
    },
    {
      "id": 12,
      "title": "Latency overall (p99 / p99.9 / max)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99.9"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max (bucketed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/metrics|/health\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "((histogram_quantile(0.999, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/metrics|/health\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99.9"
        },
        {
          "refId": "C",
          "expr": "((histogram_quantile(1, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/metrics|/health\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "max (bucketed)"
        }
      ]
    },
    {
      "id": 13,
      "title": "TCP connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sockets"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CCCCDC"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_active_resources{type=\"TCPSocketWrap\", job=\"api\"}",
          "legendFormat": "sockets"
        }
      ]
    },
    {
      "id": 14,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RSS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2CC7C7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "heap used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F8F8F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "heap total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8FE3E3"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"api\"}",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_used_bytes{job=\"api\"}",
          "legendFormat": "heap used"
        },
        {
          "refId": "C",
          "expr": "nodejs_heap_size_total_bytes{job=\"api\"}",
          "legendFormat": "heap total"
        }
      ]
    },
    {
      "id": 15,
      "title": "GC pause p99 by kind",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
