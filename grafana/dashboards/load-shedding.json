    {
      "id": 21,
      "title": "/write-transaction latency (p99 / p99.9 / max)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99.9"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max (bucketed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/write-transaction\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "((histogram_quantile(0.999, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/write-transaction\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99.9"
        },
        {
          "refId": "C",
          "expr": "((histogram_quantile(1, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/write-transaction\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "max (bucketed)"
        }
      ]
    },
