{
  "uid": "simple-demo",
  "title": "Get Transaction - Impact Metrics",
  "schemaVersion": 39,
  "refresh": "1s",
  "graphTooltip": 1,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "/get-transaction RPS by status",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "500"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_responses_total{route=\"/get-transaction\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "/get-transaction error ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_responses_total{route=\"/get-transaction\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_responses_total{route=\"/get-transaction\"}[$__rate_interval]))) >= 0) or vector(0)",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 3,
      "title": "Impact metrics (via Unleash)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-internal-impact-metrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(demo_get_transaction_success_total{job=\"unleash-impact-metrics\"}[$__rate_interval]))",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "expr": "sum(rate(demo_get_transaction_error_total{job=\"unleash-impact-metrics\"}[$__rate_interval]))",
          "legendFormat": "error"
        }
      ]
    },
    {
      "id": 4,
      "title": "/get-transaction latency (p99 / p99.9 / max)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99.9"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max (bucketed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/get-transaction\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "((histogram_quantile(0.999, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/get-transaction\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99.9"
        },
        {
          "refId": "C",
          "expr": "((histogram_quantile(1, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/get-transaction\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "max (bucketed)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency overall (p99 / p99.9 / max)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99.9"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max (bucketed)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/metrics|/health\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "expr": "((histogram_quantile(0.999, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/metrics|/health\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "p99.9"
        },
        {
          "refId": "C",
          "expr": "((histogram_quantile(1, sum by (le) (rate(http_request_duration_seconds_bucket{route!~\"/metrics|/health\"}[$__rate_interval])))) >= 0) or vector(0)",
          "legendFormat": "max (bucketed)"
        }
      ]
    },
    {
      "id": 6,
      "title": "TCP connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sockets"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CCCCDC"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_active_resources{type=\"TCPSocketWrap\", job=\"api\"}",
          "legendFormat": "sockets"
        }
      ]
    },
    {
      "id": 7,
      "title": "Memory",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RSS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2CC7C7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "heap used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F8F8F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "heap total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8FE3E3"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"api\"}",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_used_bytes{job=\"api\"}",
          "legendFormat": "heap used"
        },
        {
          "refId": "C",
          "expr": "nodejs_heap_size_total_bytes{job=\"api\"}",
          "legendFormat": "heap total"
        }
      ]
    },
    {
      "id": 8,
      "title": "GC pause p99 by kind",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "minor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A9A9A9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "major"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8F6E4B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "incremental"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D2B48C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "weakcb"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6B6B6B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, kind) (rate(nodejs_gc_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "GC time per second by kind",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "minor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A9A9A9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "major"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8F6E4B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "incremental"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D2B48C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "weakcb"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6B6B6B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(nodejs_gc_duration_seconds_sum{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
